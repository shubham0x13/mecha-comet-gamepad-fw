/*
 * How often the analog sticks are measured and how often the host reads the gamepad, in
 * milliseconds. The buttons are not part of this: they use GPIO interrupts, or polling on the
 * ports that have none.
 */
#define COMET_GAMEPAD_SAMPLE_PERIOD_MS 4

&left_stick {
	poll-period-ms = <COMET_GAMEPAD_SAMPLE_PERIOD_MS>;
};

&pivot_pip {
	poll-period-ms = <COMET_GAMEPAD_SAMPLE_PERIOD_MS>;
};

/ {
	/* The HID gamepad. The report descriptor is in src/modules/usb/gamepad_hid.c. */
	hid_gamepad: hid-gamepad {
		compatible = "zephyr,hid-device";
		label = "Mecha Comet Gamepad Extension";
		protocol-code = "none";
		/* Must be at least GAMEPAD_HID_REPORT_SIZE. */
		in-report-size = <11>;

		/*
		 * How often the host polls the gamepad. This also sets the fastest report rate, because a
		 * report is sent when the host has read the previous one.
		 */
		in-polling-period-us = <(COMET_GAMEPAD_SAMPLE_PERIOD_MS * 1000)>;
	};
};
